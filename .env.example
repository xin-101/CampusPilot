# CampusPilot 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuspilot
DB_USERNAME=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your-jwt-secret-at-least-256-bits

# Agent Provider: mock / llm / fastgpt
AGENT_PROVIDER=mock

# RAG Provider: vector / fastgpt
AGENT_RAG_PROVIDER=vector

# 知识库目录
KNOWLEDGE_DIR=./knowledge

# LLM 配置（当 AGENT_PROVIDER=llm 时使用）
LLM_ENABLED=false
LLM_BASE_URL=          # 例如 https://api.openai.com/v1
LLM_API_KEY=           # ⚠️ 仅通过环境变量注入，绝不写入代码或 Git
LLM_MODEL=gpt-4o       # 支持 GPT/DeepSeek/Qwen 等 OpenAI 兼容接口
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000
LLM_FALLBACK_TO_MOCK=false  # LLM 失败时是否回退到 Mock（默认 false）

# FastGPT 配置（当 AGENT_PROVIDER=fastgpt 时使用）
FASTGPT_URL=http://localhost:3000
FASTGPT_API_KEY=
FASTGPT_KNOWLEDGE_ID=
FASTGPT_WORKFLOW_POLICY=
FASTGPT_WORKFLOW_ELIGIBILITY=
FASTGPT_WORKFLOW_TASK=
